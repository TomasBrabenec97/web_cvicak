---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const sponzori = (await getCollection('sponzori')).sort(
  (a, b) => a.data.poradi - b.data.poradi,
);

// Loga dohledáme podle názvu souboru z frontmatteru (funguje i s cestami z CMS)
const loga = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/sponzori/*.{svg,png,jpg,jpeg,webp,SVG,PNG,JPG,JPEG,WEBP}',
  { eager: true },
);

const najdiLogo = (logo?: string) => {
  const nazev = logo?.split('/').pop();
  if (!nazev) return undefined;
  return Object.entries(loga).find(([cesta]) => cesta.endsWith(`/${nazev}`))?.[1].default;
};

// V odkazu na kartě se ukazuje jen doména („cppservis.cz“ místo celé adresy)
const domena = (odkaz: string) => {
  try {
    return new URL(odkaz).hostname.replace(/^www\./, '');
  } catch {
    return odkaz;
  }
};
---

<Layout
  title="Podporují nás"
  description="Sponzoři a partneři ZKO Nupaky – děkujeme všem, kteří podporují naši činnost."
>
  <section class="section">
    <div class="container">
      <h1>Podporují nás</h1>
      <p class="lead">
        Děkujeme všem partnerům, kteří podporují činnost našeho klubu a pomáhají
        nám rozvíjet výcvik i zázemí cvičiště.
      </p>

      <div class="grid grid-2" style="margin-top: 1.5rem;">
        {sponzori.map(({ data }) => {
          const logo = najdiLogo(data.logo);
          return (
            <article class="card sponsor-card">
              {logo && (
                <a class="sponsor-logo" href={data.odkaz} rel="noopener">
                  <Image src={logo} alt={`Logo – ${data.title}`} />
                </a>
              )}
              <h3>{data.title}</h3>
              {data.popis && <p class="muted">{data.popis}</p>}
              {data.odkaz && (
                <a class="web" href={data.odkaz} rel="noopener">
                  {domena(data.odkaz)} ↗
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Chcete nás také podpořit?</h2>
      <p class="muted">Budeme rádi za jakoukoli podporu – ozvěte se nám.</p>
      <a class="btn" href={`${base}/kontakty/`}>Kontaktujte nás</a>
    </div>
  </section>
</Layout>
